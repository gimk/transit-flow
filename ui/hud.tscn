[gd_scene format=3]

[ext_resource type="Script" path="res://ui/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://ui/debug_menu.gd" id="2_debug_menu"]
[ext_resource type="Script" path="res://ui/tool_palette.gd" id="3_tool_palette"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="TopBar" type="PanelContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2

[node name="Margin" type="MarginContainer" parent="TopBar"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 4

[node name="Row" type="HBoxContainer" parent="TopBar/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TimeLabel" type="Label" parent="TopBar/Margin/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(130, 0)
layout_mode = 2
text = "Day 1 · 06:00"

[node name="PeriodLabel" type="Label" parent="TopBar/Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
modulate = Color(1, 1, 1, 0.7)
text = "Morning Rush"

[node name="FlowLabel" type="Label" parent="TopBar/Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Flow: how close trips over the last game day came to free-flow time (failed or abandoned trips count as 0)"
mouse_filter = 1
theme_override_font_sizes/font_size = 18
text = "Flow —"

[node name="CityLabel" type="Label" parent="TopBar/Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
modulate = Color(1, 1, 1, 0.7)
tooltip_text = "Population · jobs"
mouse_filter = 1
text = "Pop 0"

[node name="StatsLabel" type="Label" parent="TopBar/Margin/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
modulate = Color(1, 1, 1, 0.5)
tooltip_text = "Vehicles on the road · stopped for 30 s+ · average cost of one simulation tick (F6: stress traffic)"
mouse_filter = 1
text = "0 vehicles"
clip_text = true
text_overrun_behavior = 3

[node name="SpeedButtons" type="HBoxContainer" parent="TopBar/Margin/Row"]
layout_mode = 2

[node name="PauseButton" type="Button" parent="TopBar/Margin/Row/SpeedButtons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 0)
layout_mode = 2
focus_mode = 0
tooltip_text = "Pause (Space)"
toggle_mode = true
text = "||"

[node name="Speed1Button" type="Button" parent="TopBar/Margin/Row/SpeedButtons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 0)
layout_mode = 2
focus_mode = 0
tooltip_text = "Normal speed (1)"
toggle_mode = true
text = "1×"

[node name="Speed2Button" type="Button" parent="TopBar/Margin/Row/SpeedButtons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 0)
layout_mode = 2
focus_mode = 0
tooltip_text = "Fast (2)"
toggle_mode = true
text = "2×"

[node name="Speed3Button" type="Button" parent="TopBar/Margin/Row/SpeedButtons"]
unique_name_in_owner = true
custom_minimum_size = Vector2(40, 0)
layout_mode = 2
focus_mode = 0
tooltip_text = "Fastest (3)"
toggle_mode = true
text = "4×"

[node name="ToolPalette" type="VBoxContainer" parent="."]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 12.0
offset_top = -52.0
offset_right = 12.0
offset_bottom = -12.0
grow_vertical = 0
theme_override_constants/separation = 6
alignment = 2
script = ExtResource("3_tool_palette")

[node name="HintLabel" type="Label" parent="ToolPalette"]
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.8)
theme_override_constants/outline_size = 6

[node name="SubMenus" type="Control" parent="ToolPalette"]
layout_mode = 2
mouse_filter = 2

[node name="Toolbar" type="PanelContainer" parent="ToolPalette"]
layout_mode = 2
size_flags_horizontal = 0

[node name="Buttons" type="HBoxContainer" parent="ToolPalette/Toolbar"]
layout_mode = 2

[node name="NotificationLabel" type="Label" parent="."]
unique_name_in_owner = true
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_top = 52.0
offset_bottom = 80.0
grow_horizontal = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.8)
theme_override_constants/outline_size = 6
horizontal_alignment = 1

[node name="DebugMenu" type="PanelContainer" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -212.0
offset_top = 48.0
offset_right = -12.0
grow_horizontal = 0
script = ExtResource("2_debug_menu")
